<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="350.0" spacing="15.0"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17.0.12"
      fx:controller="com.example.demo.HelloController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Minimal Calculator" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <!-- First Number -->
    <TextField fx:id="firstNumber" promptText="Enter first number" />

    <!-- Operator -->
    <ChoiceBox fx:id="operatorChoice" prefWidth="80" />

    <!-- Second Number -->
    <TextField fx:id="secondNumber" promptText="Enter second number" />

    <!-- Button -->
    <Button text="=" onAction="#onCalculate" prefWidth="100" />

    <!-- Result -->
    <TextField fx:id="resultField" promptText="Result" editable="false" />
</VBox>
